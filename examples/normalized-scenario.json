{
  "name": "PLDC and CLDC hardened flow",
  "app": "PLDC",
  "sourceFiles": ["FF-bop2.tsu", "Original_Raw_TestCases.xml"],
  "initialData": {
    "LOB": "PLDC",
    "STATE": "CA",
    "CIRCUMFERENCE": "48"
  },
  "actions": [
    {
      "id": "state-empty-select",
      "order": 10,
      "kind": "select",
      "origin": "raw",
      "target": {
        "key": "siteState",
        "app": "PLDC",
        "controlType": "ComboBox",
        "fieldRef": "PLDC.Site.State",
        "id": "cmbState",
        "occurrence": 2,
        "role": { "role": "combobox", "name": "State", "exact": true },
        "xpath": "//site-location//mat-select[@id='cmbState']"
      },
      "value": { "kind": "literal", "value": "" },
      "metadata": { "actionMode": "Select", "sourceGuid": "state-empty-guid" }
    },
    {
      "id": "state-real-select",
      "order": 11,
      "kind": "select",
      "origin": "raw",
      "condition": "{LOB} == \"PLDC\"",
      "target": {
        "key": "siteState",
        "app": "PLDC",
        "controlType": "ComboBox",
        "fieldRef": "PLDC.Site.State",
        "id": "cmbState",
        "occurrence": 2,
        "role": { "role": "combobox", "name": "State", "exact": true },
        "xpath": "//site-location//mat-select[@id='cmbState']"
      },
      "value": { "kind": "data", "key": "STATE" },
      "metadata": { "actionMode": "Input", "sourceGuid": "state-input-guid" }
    },
    {
      "id": "circumference-fill",
      "order": 12,
      "kind": "fill",
      "origin": "raw",
      "condition": "{LOB} == \"PLDC\"",
      "target": {
        "key": "cribCircumference",
        "app": "PLDC",
        "controlType": "TextBox",
        "fieldRef": "PLDC.Crib.Circumference",
        "id": "txtCribCircumference",
        "occurrence": 2
      },
      "value": { "kind": "data", "key": "CIRCUMFERENCE" }
    },
    {
      "id": "cldc-login",
      "order": 13,
      "kind": "click",
      "origin": "raw",
      "condition": "{LOB} == \"CLDC\"",
      "target": {
        "key": "cldcLogin",
        "app": "CLDC",
        "controlType": "Link",
        "fieldRef": "CLDC.Login.Submit",
        "id": "cl.dc.login.submit",
        "text": "Login",
        "role": { "role": "link", "name": "Login", "exact": true },
        "roleAlternates": [{ "role": "button", "name": "Login", "exact": true }]
      }
    },
    {
      "id": "generated-tab",
      "order": 14,
      "kind": "press",
      "origin": "generated",
      "target": { "key": "siteState", "id": "cmbState" },
      "value": { "kind": "literal", "value": "Tab" },
      "metadata": { "autoInserted": true }
    },
    {
      "id": "result-buffer",
      "order": 15,
      "kind": "dataSet",
      "origin": "raw",
      "dataKey": "MIGRATION_RESULT",
      "value": { "kind": "literal", "value": "completed" }
    }
  ]
}
