<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataPool</RootNamespace>
  </PropertyGroup>

  <!-- Runtime data must not propagate through project references or publish outputs. -->
  <ItemGroup>
    <Content Update="data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
