<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataPool</RootNamespace>
  </PropertyGroup>

  <!-- Client/ contains test-side helpers that reference ScenarioContextData.
       They are compiled as part of TestAutomation.csproj, not the web project. -->
