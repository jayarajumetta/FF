@page
@model DataPool.Pages.IndexModel
@{
    ViewData["Title"] = "Test Data Pool";
}

<!-- ── Username modal (shown on first visit) ─────────────────────────────── -->
<div class="modal fade" id="usernameModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="usernameModalLabel">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="usernameModalLabel">Who are you?</h5>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">
                    Enter your name so others can see who has claimed a quote.
                </p>
                <input type="text" id="usernameInput" class="form-control"
                       placeholder="e.g. Jane Smith" maxlength="50" autocomplete="off" />
                <div id="usernameError" class="text-danger small mt-1 d-none">Please enter your name.</div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary w-100" id="saveUsernameBtn">Continue</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Toast notifications ───────────────────────────────────────────────── -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999">
    <div id="appToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- ── Toolbar ────────────────────────────────────────────────────────────── -->
<div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
    <h5 class="mb-0">Quote Pool</h5>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group btn-group-sm" role="group" aria-label="Filter quotes">
            <button class="btn btn-outline-secondary" data-filter="available" onclick="setFilter('available')">Available</button>
            <button class="btn btn-outline-secondary" data-filter="all"       onclick="setFilter('all')">All</button>
            <button class="btn btn-outline-secondary" data-filter="referral"  onclick="setFilter('referral')">Referral Only</button>
        </div>
        <button class="btn btn-sm btn-outline-primary" onclick="loadQuotes()" title="Refresh">&#8635; Refresh</button>
    </div>
</div>

<p class="text-muted small mb-2" id="quoteCount"></p>

<!-- ── Table container ───────────────────────────────────────────────────── -->
<div id="tableContainer">
    <div class="text-center py-5 text-muted">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        Loading quotes&hellip;
    </div>
</div>

@section Scripts {
<script>
    const API = '/api/quotes';
    let currentFilter = 'available';
    let currentUser   = localStorage.getItem('dpUsername');

    // ── Username modal ────────────────────────────────────────────────────────
    const usernameModal = new bootstrap.Modal(document.getElementById('usernameModal'));

    function saveUsername() {
        const name = document.getElementById('usernameInput').value.trim();
        if (!name) {
            document.getElementById('usernameError').classList.remove('d-none');
            return;
        }
        localStorage.setItem('dpUsername', name);
        currentUser = name;
        document.getElementById('nav-username').textContent = currentUser;
        usernameModal.hide();
        initPage();
    }

    document.getElementById('saveUsernameBtn').addEventListener('click', saveUsername);
    document.getElementById('usernameInput').addEventListener('keydown', e => {
        if (e.key === 'Enter') saveUsername();
    });

    // ── Boot ──────────────────────────────────────────────────────────────────
    if (!currentUser) {
        usernameModal.show();
    } else {
        initPage();
    }

    function initPage() {
        document.getElementById('nav-username').textContent = currentUser;
        updateFilterButtons();
        loadQuotes();
    }

    // ── Filtering ─────────────────────────────────────────────────────────────
    function setFilter(filter) {
        currentFilter = filter;
        updateFilterButtons();
        loadQuotes();
    }

    function updateFilterButtons() {
        document.querySelectorAll('[data-filter]').forEach(btn => {
            const active = btn.dataset.filter === currentFilter;
            btn.classList.toggle('btn-secondary',         active);
            btn.classList.toggle('btn-outline-secondary', !active);
        });
    }

    // ── Load quotes ───────────────────────────────────────────────────────────
    async function loadQuotes() {
        let url = API;
        if (currentFilter === 'available') url = `${API}/available`;
        else if (currentFilter === 'referral') url = `${API}?isCommittedReferral=true`;

        document.getElementById('quoteCount').textContent = '';
        try {
            const resp = await fetch(url);
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            renderTable(await resp.json());
        } catch (err) {
            document.getElementById('tableContainer').innerHTML =
                `<div class="alert alert-danger">Could not load quotes: ${escHtml(err.message)}</div>`;
        }
    }

    // ── Render table ──────────────────────────────────────────────────────────
    function renderTable(quotes) {
        document.getElementById('quoteCount').textContent =
            `${quotes.length} quote(s) shown`;

        if (quotes.length === 0) {
            document.getElementById('tableContainer').innerHTML =
                '<div class="alert alert-info mb-0">No quotes match the current filter.</div>';
            return;
        }

        const statusBadge = {
            available: '<span class="badge bg-success">Available</span>',
            claimed:   '<span class="badge bg-warning text-dark">Claimed</span>',
            consumed:  '<span class="badge bg-secondary">Consumed</span>'
        };

        const rows = quotes.map(q => {
            const canClaim   = q.status === 'available';
            const canConsume = q.status === 'claimed' && q.claimedBy === currentUser;
            const canRelease = q.status === 'claimed' && q.claimedBy === currentUser;

            const badge = statusBadge[q.status]
                ?? `<span class="badge bg-light text-dark">${escHtml(q.status)}</span>`;

            const created = q.createdAt
                ? new Date(q.createdAt).toLocaleDateString('en-US',
                    { month: 'short', day: 'numeric', year: 'numeric' })
                : '';

            return `<tr>
                <td><code class="fw-semibold">${escHtml(q.id)}</code></td>
                <td>${escHtml(q.type)}</td>
                <td>${badge}</td>
                <td class="text-center">${q.isCommittedReferral
                    ? '<span class="text-success fw-bold" title="Yes">&#10003;</span>' : ''}</td>
                <td>${escHtml(q.state ?? '')}</td>
                <td class="text-muted small">${escHtml(q.claimedBy ?? '')}</td>
                <td class="text-muted small">${created}</td>
                <td class="text-nowrap">
                    <button class="btn btn-primary btn-sm me-1"
                            data-action="claim" data-id="${escHtml(q.id)}"
                            onclick="handleAction(this)"
                            ${canClaim ? '' : 'disabled'}>Claim</button>
                    <button class="btn btn-success btn-sm me-1"
                            data-action="consume" data-id="${escHtml(q.id)}"
                            onclick="handleAction(this)"
                            ${canConsume ? '' : 'disabled'}>Mark&nbsp;Consumed</button>
                    <button class="btn btn-outline-danger btn-sm"
                            data-action="release" data-id="${escHtml(q.id)}"
                            onclick="handleAction(this)"
                            ${canRelease ? '' : 'disabled'}>Release</button>
                </td>
            </tr>`;
        }).join('');

        document.getElementById('tableContainer').innerHTML = `
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Quote ID</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-center">Referral</th>
                            <th>State</th>
                            <th>Claimed By</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
    }

    // ── Actions ───────────────────────────────────────────────────────────────
    function handleAction(btn) {
        const action = btn.dataset.action;
        const id     = btn.dataset.id;
        doAction(action, id);
    }

    async function doAction(action, id) {
        const url = `${API}/${encodeURIComponent(id)}/${action}`;
        const needsUser = action === 'claim' || action === 'consume';
        const body = needsUser ? JSON.stringify({ username: currentUser }) : undefined;

        const successMsg = {
            claim:   `Quote ${id} claimed — it's yours!`,
            consume: `Quote ${id} marked as consumed.`,
            release: `Quote ${id} released back to Available.`
        }[action];

        try {
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body
            });
            if (resp.ok) {
                showToast(successMsg, 'bg-success');
                loadQuotes();
            } else {
                const msg = await resp.text();
                showToast(msg || 'Action failed.', 'bg-danger');
            }
        } catch {
            showToast('Network error. Please try again.', 'bg-danger');
        }
    }

    // ── Toast ─────────────────────────────────────────────────────────────────
    function showToast(message, bgClass) {
        const el = document.getElementById('appToast');
        el.className = `toast align-items-center text-white border-0 ${bgClass}`;
        document.getElementById('toastMessage').textContent = message;
        bootstrap.Toast.getOrCreateInstance(el, { delay: 4000 }).show();
    }

    // ── HTML escaping (prevent XSS from data values) ──────────────────────────
    function escHtml(str) {
        return String(str ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
</script>
}
