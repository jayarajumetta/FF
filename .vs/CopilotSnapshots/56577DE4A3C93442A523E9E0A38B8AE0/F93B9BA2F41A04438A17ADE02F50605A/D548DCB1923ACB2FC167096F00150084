'"wc_employer_safety_devices_pricing_factor": "1.005",',
'"wc_employer_safety_devices_comments": "Test Safety Devices Comments"'
)

$updated = 0
foreach ($file in $files) {
	$content = Get-Content -Raw -Path $file.FullName
	if ($content -match '"worksheet_pa_nj_premises_credit_255"') {
		continue
	}

	if ($content -match '(?m)^(\s*)"wc_modification_factor":\s*"1\.1"\r?\n(\s*)\}') {
		$indent = $Matches[1]
		$closingIndent = $Matches[2]
		$block = ($lines | ForEach-Object { "$indent$_" }) -join "`r`n"
		$replacement = "$indent\"wc_modification_factor\": \"1.1\",`r`n$block`r`n$closingIndent}"
		$newContent = [regex]::Replace($content, '(?m)^(\s*)"wc_modification_factor":\s*"1\.1"\r?\n(\s*)\}', $replacement, 1)

		if ($newContent -ne $content) {
			Set-Content -Path $file.FullName -Value $newContent -Encoding utf8
			$updated++
		}
	}
}

Write-Output "Updated files: $updated"