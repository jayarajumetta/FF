{
  "browser": {
    "channel": "msedge",
    "fallbackBrowser": "chromium",
    "headless": false,
    "ignoreHttpsErrors": true,
    "viewportWidth": 1440,
    "viewportHeight": 900,
    "actionTimeoutMs": 20000,
    "navigationTimeoutMs": 30000,
    "trace": false,
    "video": false,
    "har": false,
    "screenshotOnFailure": true,
    "screenshotEachStep": false,
    "screenshotAtScenarioEnd": false,
    "highlightInteractions": true,
    "highlightDurationMs": 120,
    "maximize": true
  },
  "reporting": {
    "excludeVideos": true,
    "excludePassedVideos": true,
    "resultsRoot": "TestResults",
    "artifactRoot": "Artifacts",
    "htmlReport": true,
    "includeResolvedData": true,
    "includeConsoleErrors": false,
    "includeNetworkErrors": false,
    "createEvidenceBundle": true,
    "attachEvidenceToTestResult": true,
    "attachPassedEvidenceToTestResult": true,
    "attachmentMode": "all",
    "maxSingleAttachmentBytes": 536870912,
    "maxAttachmentCount": 5000,
    "collectConsole": false,
    "collectNetwork": false,
    "passed": {
      "screenshot": true,
      "executionLog": true,
      "htmlReport": true,
      "video": false,
      "trace": false,
      "har": false,
      "console": false,
      "network": false,
      "bundle": false
    },
    "failed": {
      "screenshot": true,
      "executionLog": true,
      "htmlReport": true,
      "video": false,
      "trace": false,
      "har": false,
      "console": false,
      "network": false,
      "bundle": false
    }
  },
  "execution": {
    "retryCount": 0,
    "strictUnknownConditions": true,
    "externalDataFile": "TestData/ExternalDataOverrides.json",
    "deferVerificationFailures": true,
    "parallel": true
  },
  "waits": {
    "pageReadyTimeoutMs": 20000,
    "elementReadyTimeoutMs": 20000,
    "verifyTimeoutMs": 20000,
    "pollIntervalMs": 250,
    "waitForDomContentLoadedBeforeActions": true,
    "frameProbeTimeoutMs": 600,
    "dropdownOptionTimeoutMs": 3000,
    "dropdownPollIntervalMs": 100
  }
}