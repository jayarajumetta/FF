<Project>
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'CommercialLines.DuckCreek.Tests' Or '$(MSBuildProjectName)' == 'CommercialLines.ExpertQuote.Tests' Or '$(MSBuildProjectName)' == 'PersonalLines.DuckCreek.Tests'">
	<EnableConfiguredRetries>true</EnableConfiguredRetries>
  </PropertyGroup>
	<Target Name="BuildRetryGenerator" BeforeTargets="ReqnrollCreateProcessFeatureFileInputsCacheFile"
			Condition="'$(EnableConfiguredRetries)' == 'true'">
	<Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)src/InsuranceAutomation.Retry.Generator/InsuranceAutomation.Retry.Generator.csproj&quot; --configuration &quot;$(Configuration)&quot; --property:RetryGeneratorHostProject=&quot;$(MSBuildProjectName)&quot; --nologo"
		  WorkingDirectory="$(MSBuildThisFileDirectory)" />
	<PropertyGroup>
	  <RetryGeneratorBinary>$(MSBuildThisFileDirectory)src/InsuranceAutomation.Retry.Generator/bin/$(Configuration)/compiler/$(MSBuildProjectName)/netstandard2.0/InsuranceAutomation.Retry.Generator.$(MSBuildProjectName).ReqnrollPlugin.dll</RetryGeneratorBinary>
	</PropertyGroup>
	<GetFileHash Files="$(RetryGeneratorBinary)">
	  <Output TaskParameter="Hash" PropertyName="RetryGeneratorHash" />
	</GetFileHash>
	<ItemGroup>
		<ReqnrollGeneratorPlugins Include="$(RetryGeneratorBinary)" />
	  <ReqnrollProcessFeatureFileInputs Include="RetryGeneratorTimestamp">
		<_ParameterValue>$(RetryGeneratorHash)</_ParameterValue>
	  </ReqnrollProcessFeatureFileInputs>
	</ItemGroup>
  </Target>
</Project>
