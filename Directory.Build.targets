<Project>
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'CommercialLines.DuckCreek.Tests' Or '$(MSBuildProjectName)' == 'CommercialLines.ExpertQuote.Tests' Or '$(MSBuildProjectName)' == 'PersonalLines.DuckCreek.Tests'">
	<EnableConfiguredRetries>true</EnableConfiguredRetries>
  </PropertyGroup>
	<Target Name="BuildRetryGenerator" BeforeTargets="ReqnrollCreateProcessFeatureFileInputsCacheFile"
			Condition="'$(EnableConfiguredRetries)' == 'true'">
	<MSBuild Projects="$(MSBuildThisFileDirectory)src/InsuranceAutomation.Retry.Generator/InsuranceAutomation.Retry.Generator.csproj"
		 Targets="Restore;Build"
		 Properties="Configuration=$(Configuration)" />
	<PropertyGroup>
	  <RetryGeneratorBinary>$(MSBuildThisFileDirectory)src/InsuranceAutomation.Retry.Generator/bin/$(Configuration)/compiler/netstandard2.0/InsuranceAutomation.Retry.Generator.ReqnrollPlugin.dll</RetryGeneratorBinary>
	</PropertyGroup>
	<GetFileHash Files="$(RetryGeneratorBinary)">
	  <Output TaskParameter="Hash" PropertyName="RetryGeneratorHash" />
	</GetFileHash>
	<PropertyGroup>
	  <RetryGeneratorStaged>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)retry-generator/$(RetryGeneratorHash)/InsuranceAutomation.Retry.Generator.ReqnrollPlugin.dll</RetryGeneratorStaged>
	</PropertyGroup>
	<Copy SourceFiles="$(RetryGeneratorBinary)" DestinationFiles="$(RetryGeneratorStaged)" SkipUnchangedFiles="true" Condition="!Exists('$(RetryGeneratorStaged)')" />
	<ItemGroup>
		<ReqnrollGeneratorPlugins Include="$(RetryGeneratorStaged)" />
	  <ReqnrollProcessFeatureFileInputs Include="RetryGeneratorTimestamp">
		<_ParameterValue>$(RetryGeneratorHash)</_ParameterValue>
	  </ReqnrollProcessFeatureFileInputs>
	</ItemGroup>
  </Target>
</Project>
