{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioPlan",
  "type": "object",
  "required": [
    "application",
    "featureTitle",
    "scenarioTitle",
    "backgroundInstructions",
    "scenarioInstructions"
  ],
  "properties": {
    "application": {
      "type": "string"
    },
    "featureTitle": {
      "type": "string"
    },
    "scenarioTitle": {
      "type": "string"
    },
    "backgroundInstructions": {
      "type": "array"
    },
    "scenarioInstructions": {
      "type": "array"
    }
  }
}
