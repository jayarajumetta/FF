{
  "browser": {
    "name": "chromium",
    "channel": "msedge",
    "headless": true,
    "timeoutMs": 60000,
    "navigationTimeoutMs": 90000,
    "slowMoMs": 0,
    "ignoreHttpsErrors": true,
    "viewport": "1600x1000"
  },
  "execution": {
    "dryRun": false,
    "strictStepOrder": true,
    "strictLocatorAmbiguity": true,
    "executeUnknownConditions": true,
    "screenshotOnFailure": true,
    "traceEnabled": true
  },
  "security": {
    "allowProcessExecution": false,
    "allowFileMutation": false,
    "allowJsonPreferenceMutation": false
  },
  "paths": {
    "plans": "Plans",
    "testData": "TestData",
    "locators": "Locators",
    "artifacts": "artifacts/runtime",
    "tdmOverrides": "TestData/TdmOverrides.json",
    "sourceValueOverrides": "TestData/SourceValueOverrides.json"
  }
}
