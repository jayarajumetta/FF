{
  "Framework": {
    "ApplicationCode": "CL_EQ",
    "Browser": "chromium",
    "Channel": "msedge",
    "Headless": true,
    "SlowMoMs": 0,
    "DefaultTimeoutMs": 60000,
    "NavigationTimeoutMs": 90000,
    "StrictLocatorAmbiguity": true,
    "UnknownConditionPolicy": "SkipAndLog",
    "FailOnSyntheticExternalData": true,
    "ScreenshotOnPassedStep": false,
    "ScreenshotOnFailedStep": true,
    "RecordVideo": true,
    "RecordTrace": true,
    "CaptureDomOnFailure": true,
    "CleanCookiesBeforeScenario": true,
    "CloseExtraPagesAfterScenario": true,
    "EnableProcessCleanup": false,
    "ArtifactsRoot": "artifacts/runs",
    "LocatorCatalog": "Locators/locator-catalog.json",
    "ExternalOverrides": "TestData/ExternalDataOverrides.json",
    "HtmlReport": {
      "Enabled": true,
      "FileName": "cl_eq-execution-report.html"
    },
    "EmailReport": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "EnableSsl": true,
      "From": "",
      "To": [],
      "UsernameEnvironmentVariable": "REPORT_SMTP_USERNAME",
      "PasswordEnvironmentVariable": "REPORT_SMTP_PASSWORD"
    }
  },
  "Application": {
    "Code": "CL_EQ",
    "Name": "Commercial Lines ExpertQuote",
    "BaseUrl": "https://expertquote-qa.americannational.com/expertquote/",
    "AuthenticationMode": "FormOrExistingSession",
    "UsernameEnvironmentVariable": "CL_EQ_USERNAME",
    "PasswordEnvironmentVariable": "CL_EQ_PASSWORD",
    "UsernameControl": "Username",
    "PasswordControl": "Password",
    "SignInControl": "Sign On",
    "ReadyControl": "New Quote",
    "LoadingControl": "Loading ..."
  }
}
