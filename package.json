{
  "name": "ff-bop-complete-e2e-v58",
  "version": "58.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven Tosca to Playwright v58 for Duck Creek PLDC, CLDC and CL_EQ exports",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./compat/v56": {
      "types": "./dist/src/compat/v56-adapter.d.ts",
      "import": "./dist/src/compat/v56-adapter.js"
    },
    "./v58": {
      "types": "./dist/v58/index.d.ts",
      "require": "./dist/v58/index.js",
      "default": "./dist/v58/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG-v57.md",
    "SOURCE-AUDIT.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm test && node scripts/verify-package.mjs",
    "v58:build": "tsc -p tsconfig.v58.json && node scripts/v58-postbuild.mjs",
    "v58:test": "node --test tests/v58/*.test.mjs",
    "v58:verify": "npm run v58:build && npm run v58:test && node scripts/verify-v58.mjs",
    "v58:convert": "node scripts/convert-tosca-v58.mjs",
    "v58:audit": "node scripts/convert-tosca-v58.mjs audit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": ">=1.40.0 <2",
    "@types/node": ">=20",
    "typescript": ">=5.4.0 <6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "keywords": [
    "cldc",
    "duck-creek",
    "fieldref",
    "iframe",
    "playwright",
    "pldc",
    "tosca",
    "v58"
  ]
}
