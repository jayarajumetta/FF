{
  "name": "ff-bop-complete-e2e-v57",
  "version": "57.0.0",
  "private": true,
  "type": "module",
  "description": "v57 Tosca-to-Playwright conversion runtime and generator hardening overlay",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./compat/v56": {
      "types": "./dist/src/compat/v56-adapter.d.ts",
      "import": "./dist/src/compat/v56-adapter.js"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG-v57.md",
    "SOURCE-AUDIT.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm test && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": ">=1.40.0 <2",
    "@types/node": ">=20",
    "typescript": ">=5.4.0 <6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
