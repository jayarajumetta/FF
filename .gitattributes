# Auto detect text files and perform LF normalization
* text=auto eol=lf
## Source code
*.cs       text diff=csharp
*.csproj   text
*.sln      text eol=crlf
*.json     text
*.xml      text
*.config   text
*.feature  text
*.yml      text
*.yaml     text
*.md       text
*.ps1      text eol=crlf
*.sh       text eol=lf
## Windows-specific scripts must keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
## Binary files - do not touch line endings
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.bmp      binary
*.dll      binary
*.exe      binary
*.pdb      binary
*.zip      binary
*.7z       binary
*.pfx      binary
*.snk      binary
*.ttf      binary
*.eot      binary
*.woff     binary
*.woff2    binary
## Git LFS tracked binary/large assets
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
## Exclude generated/vendor files from GitHub language stats and diffs
tests/**/bin/** linguist-generated=true
tests/**/obj/** linguist-generated=true
**/[Bb]in/** linguist-vendored
**/[Oo]bj/** linguist-vendored
