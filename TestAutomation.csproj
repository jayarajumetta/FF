
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PnCTestAutomation</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gherkin" Version="37.0.1" />

    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.0.1" />
    <PackageReference Include="Reqnroll" Version="3.3.0" />
    <PackageReference Include="Reqnroll.Microsoft.Extensions.DependencyInjection" Version="3.3.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <!-- DataPool must be built so DataPoolLauncher can find and start it at runtime -->
  <ItemGroup>
    <ProjectReference Include="DataPool\DataPool.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Glob rather than just appsettings.json: Startup loads appsettings.{TEST_ENVIRONMENT}.json
         with optional:true, so an env file that never reaches the output folder fails silently. -->
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Exclude generated locator files from compilation -->
  <!-- Exclude nested project folders so their obj-generated files are not globbed -->
  <ItemGroup>
    <Compile Remove="TestResults\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="TestAutomation.ApiTests\**\*" />
    <Compile Remove="TestAutomation.UnitTests\**\*" />
    <Compile Remove="SimpleCapture\**\*" />
    <Compile Remove="Tools\CiTestInventory\**\*" />
    <!-- DataPool is a fully standalone web project — exclude all its source from TestAutomation compilation -->
    <Compile Remove="DataPool\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Pages\_Staged\" />
  </ItemGroup>

</Project>
